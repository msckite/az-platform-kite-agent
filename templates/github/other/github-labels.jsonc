// Default label set for the Kite Agent HITL process. Agents act on the stable "key", never on the label "name",
// so you can rename labels freely. Every key listed here must exist in your set. Copy and customize, then run:
// Set-GitHubLabels -LabelFilePath ./github-labels.jsonc -Owner <owner> -Repository <repo>
{
  "$schema": "https://raw.githubusercontent.com/msckite/az-platform-kite-agent/refs/heads/main/schemas/github-labels.schema.json",
  "templateVersion": "1.0.0",
  "labels": [
    {
      "key": "bug",
      "name": "bug :beetle:",
      "color": "#d73a4a",
      "description": "Something isn't working"
    },
    {
      "key": "chore",
      "name": "chore :wrench:",
      "color": "#6e9c94",
      "description": "Routine tasks and maintenance"
    },
    {
      "key": "completed",
      "name": "completed :white_check_mark:",
      "color": "#e8e8e8",
      "description": "This item has been completed"
    },
    {
      "key": "documentation",
      "name": "documentation :page_facing_up:",
      "color": "#0075ca",
      "description": "Improvements or additions to documentation"
    },
    {
      "key": "duplicate",
      "name": "duplicate :palms_up_together:",
      "color": "#cfd3d7",
      "description": "This issue or pull request already exists"
    },
    {
      "key": "enhancement",
      "name": "enhancement :sparkles:",
      "color": "#99c58f",
      "description": "New feature or request"
    },
    {
      "key": "good-first-issue",
      "name": "good first issue :heart:",
      "color": "#7057ff",
      "description": "Good for newcomers"
    },
    {
      "key": "help-wanted",
      "name": "help wanted :hatching_chick:",
      "color": "#008672",
      "description": "Extra attention is needed"
    },
    {
      "key": "in-pr",
      "name": "in pr :point_right:",
      "color": "#344966",
      "description": "This is when an issue is due because a pull request is still open"
    },
    {
      "key": "in-progress",
      "name": "in progress :dart:",
      "color": "#e8e8e8",
      "description": "This item is in progress and will be worked on"
    },
    {
      "key": "invalid",
      "name": "invalid :x:",
      "color": "#e8e8e8",
      "description": "This doesn't seem right"
    },
    {
      "key": "long-term",
      "name": "long term :hourglass:",
      "color": "#e8e8e8",
      "description": "Will be worked on, but will take a longer amount of time due to complexity or priorities"
    },
    {
      "key": "needs-triage",
      "name": "needs triage :wave:",
      "color": "#e8e8e8",
      "description": "Needs triage by the team"
    },
    {
      "key": "on-hold",
      "name": "on hold :lock:",
      "color": "#e8e8e8",
      "description": "This is on hold until further notice"
    },
    {
      "key": "question",
      "name": "question :question:",
      "color": "#fbca04",
      "description": "Further information is requested"
    },
    {
      "key": "todo",
      "name": "todo :construction_worker:",
      "color": "#e8e8e8",
      "description": "A task that needs to be done"
    },
    {
      "key": "wontfix",
      "name": "wontfix :-1:",
      "color": "#ffffff",
      "description": "This will not be worked on"
    },
    {
      "key": "plan-proposed",
      "name": "plan proposed :clipboard:",
      "color": "#fbca04",
      "description": "An agent proposed a plan that waits for human review"
    },
    {
      "key": "approved",
      "name": "approved :ballot_box_with_check:",
      "color": "#0e8a16",
      "description": "A human approved the plan; work may start"
    }
  ]
}